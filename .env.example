DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_USER=paper-tracker-local
DIFY_TIMEOUT_SECONDS=120
DIFY_MAX_RETRIES=2
RESEARCH_INTERESTS=EEG、脑机接口、运动想象分类、深度学习、Transformer、跨被试迁移学习
ANALYSIS_PROFILE=v1
ARXIV_CATEGORIES=cs.LG,q-bio.NC,eess.SP,cs.HC
ARXIV_KEYWORDS=EEG,electroencephalography,brain-computer interface,brain computer interface,motor imagery
ARXIV_LOOKBACK_DAYS=30
ARXIV_PAGE_SIZE=50
ARXIV_MAX_PAGES=3
ARXIV_MAX_RETRIES=2
ARXIV_CACHE_TTL_SECONDS=900
MAX_PAPERS=10
MIN_SCORE=50
TOP_K=5
# Email is only sent with --send-email; --daily prevents repeated daily digests.
SMTP_SERVER=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
