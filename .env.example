DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_USER=paper-tracker-local
DIFY_TIMEOUT_SECONDS=120
DIFY_MAX_RETRIES=2
RESEARCH_INTERESTS=EEG、脑机接口、运动想象分类、深度学习、Transformer、跨被试迁移学习
ANALYSIS_PROFILE=v1
ARXIV_CATEGORIES=cs.LG,q-bio.NC
ARXIV_LOOKBACK_DAYS=5
MAX_PAPERS=3
MIN_SCORE=70
TOP_K=5
# Email is only sent with --send-email. Do not overwrite an existing .env.
SMTP_SERVER=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
